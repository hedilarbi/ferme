# ─── SQLite database ────────────────────────────────────────────────────────
# Prisma resolves this path relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ─── Multi-server encryption key ─────────────────────────────────────────────
# Required when running multiple Next.js instances behind a load balancer.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ─── Deployment ID ───────────────────────────────────────────────────────────
# Set to your git SHA or release tag for version-skew protection.
# DEPLOYMENT_VERSION="$(git rev-parse HEAD)"

# ─── Internal API ────────────────────────────────────────────────────────────
# Shared secret for POST /api/internal/sites
INTERNAL_API_SECRET="change-me-in-production"
